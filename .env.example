# ==============================================================================
# GraphGPT LLM Service Environment Configuration Template
# ==============================================================================

ENVIRONMENT=development
SERVICE_NAME=llm-service
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Provider API Keys & Hyperparameters
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=5000
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=2048
# Groq counts prompt + max_tokens against tokens-per-minute per request; the free/on-demand tier of
# gpt-oss-20b allows 8000. Output budgets are shrunk to fit. 0 = no cap (paid tiers).
GROQ_TPM_LIMIT=8000
# LEGACY per-request INPUT cap, OFF (0) by default so the context budget below is what applies. Set e.g. 5000 ONLY if your
# Groq account is rate-limited (free tier: 8000 tokens/min); it is then applied as a minimum on top of the budget.
PROMPT_TOKEN_BUDGET=0

# ---- Context budget (application policy; independent of provider tokens-per-minute limits) ----
# Max tokens one request may use in total (system + history + memory + retrieval + tools + output reserve + margin).
# The model's real window is a second ceiling; the effective budget is the smaller of the two.
CONTEXT_BUDGET_ENABLED=true
CONTEXT_BUDGET_DEFAULT_TOKENS=150000
CONTEXT_BUDGET_GROQ_TOKENS=150000
CONTEXT_BUDGET_GEMINI_TOKENS=150000
# Optional JSON overrides: CONTEXT_BUDGET_MODEL_OVERRIDES={"groq:openai/gpt-oss-120b": 100000}
# Real windows for models NOT in the built-in table (verify with the provider): CONTEXT_MODEL_WINDOWS={"qwen/qwen3.8-27b": 131072}
CONTEXT_UNKNOWN_MODEL_WINDOW_TOKENS=32768

# ---- Automatic compaction ----
# Compact the history when the estimated input reaches TRIGGER of the input budget (or exceeds it); aim for TARGET.
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_COMPACTION_TRIGGER_RATIO=0.85
CONTEXT_COMPACTION_TARGET_RATIO=0.65
CONTEXT_COMPACTION_MIN_RECENT_MESSAGES=6

# ---- Token safety (counts are estimates; no provider tokenizer is available locally) ----
CONTEXT_TOKEN_SAFETY_MARGIN=0.05
CONTEXT_OUTPUT_TOKEN_RESERVE=8192
# Answer generation tries these in order; the first to produce a token wins, the rest are fallbacks.
# groq:<model> uses the same GROQ_API_KEY (each model has its own rate limits). NVIDIA is last: it can take
# 1-2 minutes. The same Groq models also back up request planning and search-query rewriting.
GENERATION_PROVIDER_ORDER=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini,groq:openai/gpt-oss-20b,nvidia

NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.7
NVIDIA_MAX_TOKENS=8192
NVIDIA_TIMEOUT_MS=30000

GEMINI_API_KEY=your_gemini_api_key
# Who answers when the primary generation provider (NVIDIA) fails: gemini | groq | none.
# Only the chosen provider is contacted as the fallback; none fails the turn immediately.
GENERATION_FALLBACK_PROVIDER=gemini
# If NVIDIA yields no visible token within this time, the turn is handed to the fallback provider
# (set GENERATION_FALLBACK_PROVIDER=groq for fast local development). Idle = max gap between tokens.
GENERATION_FIRST_TOKEN_TIMEOUT_MS=8000
GENERATION_IDLE_TIMEOUT_MS=20000
GENERATION_FALLBACK_FIRST_TOKEN_TIMEOUT_MS=30000
# Skip Memory/Graph/analysis for trivial greetings (hi, thanks, bye ...). Generation is unchanged.
ENABLE_FAST_PATH=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.95
GEMINI_MAX_TOKENS=8192
GEMINI_TIMEOUT_MS=15000

TAVILY_API_KEY=your_tavily_api_key

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=llm-service-group
KAFKA_INPUT_TOPIC=chat.message.created
KAFKA_OUTPUT_TOPIC=chat.response.generated
KAFKA_CHUNK_TOPIC=chat.response.chunk
KAFKA_DLQ_TOPIC=chat.message.dlq
KAFKA_MAX_POLL_INTERVAL_MS=300000

# gRPC Services (Context Collector)
MEMORY_SERVICE_HOST=localhost
MEMORY_SERVICE_PORT=50051
GRAPH_SERVICE_HOST=localhost
GRAPH_SERVICE_PORT=50052
RETRIEVAL_SERVICE_HOST=localhost
RETRIEVAL_SERVICE_PORT=50060
GRPC_DEADLINE_MS=2000
GRPC_MAX_CONNECTIONS=20

# Feature Flags
ENABLE_SMART_MODE=true
ENABLE_DEEP_RESEARCH_MODE=true
ENABLE_WEB_SEARCH=true
FEATURE_VISION=false
FEATURE_GRPC_KEEPALIVE=true

# Loop Limits
LANGGRAPH_MAX_LOOP_ITERATIONS_SMART=6
LANGGRAPH_MAX_LOOP_ITERATIONS_DEEP_RESEARCH=4
WEB_SEARCH_TIMEOUT_MS=5000

# Observability
OTEL_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# ---- Visualizations (Mermaid diagrams / Manim animations) ----
VISUALIZATION_ENABLED=true
MERMAID_ENABLED=true
MANIM_ENABLED=false                 # off by default: needs a Manim-capable interpreter + ffmpeg
VISUALIZATION_MODES=default,tutor,code,smart
VISUALIZATION_MAX_ATTEMPTS=3        # TOTAL attempts per block (1 original + 2 repairs)
MANIM_PYTHON=                       # interpreter with manim installed (empty = this interpreter)
MANIM_INLINE_WORKER=true            # false = jobs go through Redis to `python -m app.visualization.worker`
VISUALIZATION_INTERNAL_TOKEN=       # shared secret for the worker -> /api/internal/visualizations/repair
